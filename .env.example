# Copy to .env for local development. Never commit .env.
DATABASE_URL="file:./dev.db"

# Auth.js / next-auth. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Local demo access (development only; seed refuses to run when NODE_ENV=production).
# Leave blank and `npm run setup` generates random passwords and prints them once.
DEMO_USER_PASSWORD=""
DEMO_ADMIN_PASSWORD=""

# Live grading (Anthropic API). Without a key the app runs in a clearly labeled demonstration mode.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"

# Speech transcription (OpenAI audio transcription API). Without a key, typed answers still work.
TRANSCRIPTION_PROVIDER="openai"
OPENAI_API_KEY=""
TRANSCRIPTION_MODEL="whisper-1"
