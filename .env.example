# Copy to .env for local development. Never commit .env.
# Local dev: run `npm run db:dev` in a second terminal (embedded Postgres, no install needed).
# Production: Neon pooled connection string. DIRECT_URL = Neon direct (non-pooled) string, used for migrations.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/interview"
DIRECT_URL=""

# Auth.js / next-auth. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Local demo access (development only; never created by `npm run db:bootstrap`).
# Leave blank and `npm run setup` generates random passwords and prints them once.
DEMO_USER_PASSWORD=""
DEMO_ADMIN_PASSWORD=""

# Live grading (Anthropic API). Without a key the app runs in a clearly labeled demonstration mode.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"

# Speech transcription (OpenAI audio transcription API). Without a key, typed answers still work.
TRANSCRIPTION_PROVIDER="openai"
OPENAI_API_KEY=""
TRANSCRIPTION_MODEL="whisper-1"

# One-time production bootstrap (`npm run db:bootstrap`): creates the owner/admin account. Do NOT set these on the host.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
